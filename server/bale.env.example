# توکن ربات بله (از BotFather بله). ربات باید در گروه رانندگان پمپ ادمین باشد.
BALE_TOKEN=

# رمز اپ — همین را در اپ، دکمه‌ی «تنظیم پل بله» وارد کن.
# می‌تواند همان APP_TOKEN سرویس همگام‌سازی باشد.
APP_TOKEN=

PORT=8790
DIR=/opt/sobhan/bale
POLL_SEC=60
# CHAT_ID=-100xxxxxxxxx   # اگر فقط یک گروه مدنظر است، شناسه‌ی گروه را بگذار
