[Unit]
Description=Sobhan Beton sync service
Documentation=https://github.com/Saeid4184/sobhanasistant
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/opt/sobhan/sync.env
ExecStart=/usr/bin/node /opt/sobhan/sync-server.js
WorkingDirectory=/opt/sobhan
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/sobhan

[Install]
WantedBy=multi-user.target
